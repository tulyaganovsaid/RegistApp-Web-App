{
  "entities": {
    "User": {
      "title": "User",
      "description": "App client or staff member credentials and details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["Client", "Operator", "Admin"] },
        "isVerified": { "type": "boolean" },
        "passwordHash": { "type": "string" }
      },
      "required": ["id", "email", "firstName", "lastName", "role", "isVerified"]
    },
    "Order": {
      "title": "Order",
      "description": "Tourist booking and document registration order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "passportNumber": { "type": "string" },
        "country": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Payment Pending", "In Progress", "Paid", "Completed", "Rejected due to violations"] },
        "usdAmount": { "type": "number" },
        "currency": { "type": "string" },
        "arrivalDate": { "type": "string" },
        "departureDate": { "type": "string" },
        "daysCount": { "type": "number" },
        "paymentTxId": { "type": "string" },
        "operatorId": { "type": "string" },
        "operatorNotes": { "type": "string" },
        "finalDocUrl": { "type": "string" },
        "finalDocName": { "type": "string" },
        "violationReportUrl": { "type": "string" }
      },
      "required": ["id", "clientName", "clientEmail", "status", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Application regulatory copy, keys and chatbot script rules",
      "type": "object",
      "properties": {
        "supportAiScript": { "type": "string" },
        "publicOfferText": { "type": "string" },
        "publicOfferTextFR": { "type": "string" },
        "publicOfferTextRU": { "type": "string" },
        "legalKnowledgeBase": { "type": "string" },
        "legalKnowledgeBaseUpdatedAt": { "type": "string" }
      },
      "required": ["supportAiScript", "publicOfferText"]
    },
    "TouristNews": {
      "title": "TouristNews",
      "description": "Tourism news article for foreign visitors in Uzbekistan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "illustration": { "type": "string" },
        "body": { "type": "string" },
        "summary": { "type": "string" },
        "category": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "author": { "type": "string" }
      },
      "required": ["id", "title", "body", "publishedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "History of system events, logins and state transformations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "userEmail", "action", "details"]
    },
    "Consent": {
      "title": "Consent",
      "description": "Proof of client consent to legal terms, personal data processing, cross-border transfer, and independent tourist status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "timestamp": { "type": "string" },
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" },
        "locale": { "type": "string" },
        "consents": {
          "type": "object",
          "properties": {
            "dataProcessing": { "type": "boolean" },
            "thirdPartyTransfer": { "type": "boolean" },
            "crossBorderTransfer": { "type": "boolean" },
            "termsAccepted": { "type": "boolean" },
            "marketing": { "type": "boolean" },
            "selfTravellerStatus": { "type": "boolean" }
          },
          "required": [
            "dataProcessing",
            "thirdPartyTransfer",
            "crossBorderTransfer",
            "termsAccepted",
            "marketing",
            "selfTravellerStatus"
          ]
        },
        "documentsVersion": {
          "type": "object",
          "properties": {
            "privacyVersion": { "type": "string" },
            "termsVersion": { "type": "string" },
            "cookiesVersion": { "type": "string" }
          },
          "required": [
            "privacyVersion",
            "termsVersion",
            "cookiesVersion"
          ]
        },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" }
      },
      "required": [
        "orderId",
        "timestamp",
        "ipAddress",
        "userAgent",
        "locale",
        "consents",
        "documentsVersion"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user auth profiles and access roles"
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Collection of temporary registration document workflows"
    },
    "system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Singleton config parameters document"
    },
    "tourist_news/{newsId}": {
      "schema": { "$ref": "#/entities/TouristNews" },
      "description": "Tourism and regulatory news collection"
    },
    "audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Traceability ledger for backend system inspections"
    },
    "consents/{consentId}": {
      "schema": { "$ref": "#/entities/Consent" },
      "description": "Immutable ledger of user consents for GDPR and Uzbek Personal Data Law compliance"
    }
  }
}
